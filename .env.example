# Credenciales de PostgreSQL usadas por docker-compose para crear el contenedor local.
POSTGRES_USER=roda
POSTGRES_PASSWORD=roda_local_password
POSTGRES_DB=roda

# Puerto que expone el contenedor en el host. Cambialo (por ejemplo a 5433) si ya tienes
# un PostgreSQL instalado localmente ocupando el 5432, y ajusta los puertos de las URLs.
POSTGRES_PORT=5432

# Conexion que usa la aplicacion cuando se ejecuta EN EL HOST (uvicorn local, pytest).
# Dentro de docker-compose el servicio "api" recibe host "db" en lugar de "localhost".
DATABASE_URL=postgresql+psycopg://roda:roda_local_password@localhost:5432/roda

# Base de datos dedicada a los tests de integracion. La crea docker-compose al inicializar.
TEST_DATABASE_URL=postgresql+psycopg://roda:roda_local_password@localhost:5432/roda_test

# Tasa que usa el simulador, como fraccion decimal EFECTIVA ANUAL (0.24 = 24 % E.A.).
# La prueba tecnica no especifica ninguna tasa: es un supuesto de demo configurable y no
# corresponde a la tasa real de Roda.
CREDIT_ANNUAL_RATE=0.24

# Tope maximo de tasa aceptado por el sistema, como fraccion decimal EFECTIVA ANUAL.
# Es configuracion porque los limites regulatorios varian por modalidad y periodo. El valor
# de referencia de la demo debe revisarse contra el limite legal vigente antes de produccion.
CREDIT_MAX_ANNUAL_RATE=0.45

# local | test | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Origenes permitidos por CORS, separados por coma.
# En local: el origen de Vite. En produccion: SOLO la URL del frontend en Vercel
# (https://....vercel.app o el dominio propio). Nunca '*' si ENVIRONMENT=production:
# la aplicacion se niega a arrancar.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Produccion (Cloud Run + Cloud SQL). No rellenar aqui; van en Secret Manager. ---
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# CORS_ALLOW_ORIGINS=https://tu-frontend.vercel.app
